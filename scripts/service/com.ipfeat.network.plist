<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ipfeat.network</string>
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>_ipfeat_engine</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ipFeat/ipfeat-supervisor.sh</string>
        <string>__SING_BOX__</string>
        <string>__CONFIG__</string>
        <string>__LIVE_POLICY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/ipFeat/network.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/ipFeat/network.log</string>
</dict>
</plist>
