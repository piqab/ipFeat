<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ipfeat.updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/ipFeat/ipFeatUpdater</string>
        <string>--config</string>
        <string>__CONFIG__</string>
        <string>--auto-policy</string>
        <string>__POLICY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Library/Logs/ipFeat/updater.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/ipFeat/updater.log</string>
</dict>
</plist>
