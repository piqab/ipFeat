@@ -0,0 +1,184 @@
+package route
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"os"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	R "github.com/sagernet/sing-box/route/rule"
+	"golang.org/x/sys/unix"
+)
+
+type ipInformerPromptChoice struct {
+	ready chan struct{}
+	route string
+}
+
+type ipInformerPromptRequest struct {
+	ID              string `json:"id"`
+	ApplicationID   string `json:"application_id"`
+	ApplicationName string `json:"application_name"`
+	CommandPath     string `json:"command_path"`
+}
+
+type ipInformerPromptReply struct {
+	ID    string `json:"id"`
+	Route string `json:"route"`
+}
+
+// A prompt is only eligible for a positively identified descendant's public
+// IPv4 connection. Private traffic, DNS, and ambiguous ownership use the
+// ordinary policy without pausing the flow.
+func (r *Router) ipInformerPromptFor(metadata *adapter.InboundContext) *ipInformerPrompt {
+	policy := r.livePolicy.Load()
+	if policy == nil || policy.socketPath == "" || metadata.ProcessInfo == nil ||
+		metadata.ProcessInfo.ProcessPath == "" || len(metadata.ProcessInfo.AncestorProcessPaths) == 0 ||
+		metadata.IPVersion != 4 || metadata.Destination.Port == 53 {
+		return nil
+	}
+	addr := metadata.Destination.Addr
+	if !addr.IsValid() || !addr.IsGlobalUnicast() || addr.IsPrivate() ||
+		addr.IsLoopback() || addr.IsLinkLocalUnicast() {
+		return nil
+	}
+	for i := range policy.prompts {
+		prompt := &policy.prompts[i]
+		if prompt.excluded[metadata.ProcessInfo.ProcessPath] {
+			continue
+		}
+		self := false
+		ancestor := false
+		for _, pattern := range prompt.patterns {
+			self = self || pattern.MatchString(metadata.ProcessInfo.ProcessPath)
+			for _, path := range metadata.ProcessInfo.AncestorProcessPaths {
+				ancestor = ancestor || pattern.MatchString(path)
+			}
+		}
+		if ancestor && !self {
+			return prompt
+		}
+	}
+	return nil
+}
+
+func (r *Router) ipInformerPromptRule(ctx context.Context, metadata *adapter.InboundContext) adapter.Rule {
+	prompt := r.ipInformerPromptFor(metadata)
+	if prompt == nil {
+		return nil
+	}
+	policy := r.livePolicy.Load()
+	if policy == nil {
+		return nil
+	}
+	key := prompt.id + "\x00" + metadata.ProcessInfo.ProcessPath
+	r.promptAccess.Lock()
+	if r.promptChoices == nil {
+		r.promptChoices = make(map[string]*ipInformerPromptChoice)
+	}
+	choice := r.promptChoices[key]
+	first := choice == nil
+	if first {
+		if r.promptPending >= 16 || len(r.promptChoices) >= 1024 {
+			r.promptAccess.Unlock()
+			return nil
+		}
+		choice = &ipInformerPromptChoice{ready: make(chan struct{})}
+		r.promptChoices[key] = choice
+		r.promptPending++
+	}
+	r.promptAccess.Unlock()
+	if first {
+		choice.route = r.askIPInformer(ctx, policy.socketPath, ipInformerPromptRequest{
+			ID: key, ApplicationID: prompt.id, ApplicationName: prompt.name,
+			CommandPath: metadata.ProcessInfo.ProcessPath,
+		})
+		close(choice.ready)
+		r.promptAccess.Lock()
+		r.promptPending--
+		r.promptAccess.Unlock()
+	} else {
+		select {
+		case <-choice.ready:
+		case <-time.After(9 * time.Second):
+			return nil
+		case <-ctx.Done():
+			return nil
+		}
+	}
+	if choice.route == "" {
+		return nil
+	}
+	if choice.route == "reject" {
+		return ipInformerDecisionRule{action: &R.RuleActionReject{Method: C.RuleActionRejectMethodDefault, NoDrop: true}}
+	}
+	if _, exists := r.outbound.Outbound(choice.route); !exists {
+		return nil
+	}
+	return ipInformerDecisionRule{action: &R.RuleActionRoute{Outbound: choice.route}}
+}
+
+func (r *Router) askIPInformer(ctx context.Context, socketPath string, request ipInformerPromptRequest) string {
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	info, err := os.Stat(socketPath)
+	if err != nil || info.Mode()&os.ModeSocket == 0 {
+		return ""
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid == 0 {
+		return ""
+	}
+	conn, err := (&net.Dialer{Timeout: 500 * time.Millisecond}).DialContext(ctx, "unix", socketPath)
+	if err != nil {
+		return ""
+	}
+	defer conn.Close()
+	raw, err := conn.(*net.UnixConn).SyscallConn()
+	if err != nil {
+		return ""
+	}
+	var peerUID uint32
+	var credentialErr error
+	if err = raw.Control(func(fd uintptr) {
+		var credential *unix.Xucred
+		credential, credentialErr = unix.GetsockoptXucred(int(fd), unix.SOL_LOCAL, unix.LOCAL_PEERCRED)
+		if credentialErr == nil {
+			peerUID = credential.Uid
+		}
+	}); err != nil || credentialErr != nil || peerUID != owner.Uid {
+		return ""
+	}
+	_ = conn.SetDeadline(time.Now().Add(8 * time.Second))
+	if err = json.NewEncoder(conn).Encode(request); err != nil {
+		return ""
+	}
+	var reply ipInformerPromptReply
+	if err = json.NewDecoder(conn).Decode(&reply); err != nil || reply.ID != request.ID {
+		return ""
+	}
+	if reply.Route == "reject" {
+		return "reject"
+	}
+	if strings.ContainsAny(reply.Route, "\x00\r\n") {
+		return ""
+	}
+	if _, exists := r.outbound.Outbound(reply.Route); !exists {
+		return ""
+	}
+	return reply.Route
+}
+
+type ipInformerDecisionRule struct{ action adapter.RuleAction }
+
+func (ipInformerDecisionRule) Match(*adapter.InboundContext) bool { return true }
+func (ipInformerDecisionRule) String() string                     { return "IP Informer child command choice" }
+func (ipInformerDecisionRule) Type() string                       { return C.RuleTypeDefault }
+func (r ipInformerDecisionRule) Action() adapter.RuleAction       { return r.action }
+func (ipInformerDecisionRule) Start() error                       { return nil }
+func (ipInformerDecisionRule) Close() error                       { return nil }
