+++ b/common/process/ancestor_darwin_test.go
@@ -0,0 +1,49 @@
+//go:build darwin
+
+package process
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestReadDarwinBSDInfoForCurrentProcess(t *testing.T) {
+	info, ok := readDarwinBSDInfo(uint32(os.Getpid()))
+	if !ok {
+		t.Fatal("could not read proc_bsdinfo")
+	}
+	if info.pid != uint32(os.Getpid()) || info.ppid != uint32(os.Getppid()) || info.uid != int32(os.Getuid()) {
+		t.Fatalf("wrong identity: %+v", info)
+	}
+	if info.startSec == 0 {
+		t.Fatal("missing process start time")
+	}
+}
+
+func TestAncestorsRejectWrongUID(t *testing.T) {
+	paths := darwinAncestorPaths(uint32(os.Getpid()), int32(os.Getuid()+1))
+	if len(paths) != 0 {
+		t.Fatalf("wrong UID inherited paths: %v", paths)
+	}
+}
+
+func TestAncestorOfSpawnedCommandIncludesCurrentProcess(t *testing.T) {
+	command := exec.Command("/bin/sleep", "2")
+	if err := command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = command.Process.Kill(); _ = command.Wait() }()
+	paths := darwinAncestorPaths(uint32(command.Process.Pid), int32(os.Getuid()))
+	current, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range paths {
+		if filepath.Base(path) == filepath.Base(current) {
+			return
+		}
+	}
+	t.Fatalf("spawned command did not inherit current process: %v", paths)
+}
