+package rule
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+func TestAncestorProcessRegexDoesNotMatchCurrentProcess(t *testing.T) {
+	item, err := NewAncestorProcessPathRegexItem([]string{`^/Applications/iTerm.app/.+$`})
+	if err != nil {
+		t.Fatal(err)
+	}
+	metadata := adapter.InboundContext{ProcessInfo: &adapter.ConnectionOwner{
+		ProcessPath:          "/usr/bin/ssh",
+		AncestorProcessPaths: []string{"/bin/zsh", "/Applications/iTerm.app/Contents/MacOS/iTerm2"},
+	}}
+	if !item.Match(&metadata) {
+		t.Fatal("iTerm ancestor was not matched")
+	}
+	metadata.ProcessInfo.AncestorProcessPaths = []string{"/bin/zsh"}
+	metadata.ProcessInfo.ProcessPath = "/Applications/iTerm.app/Contents/MacOS/iTerm2"
+	if item.Match(&metadata) {
+		t.Fatal("ancestor rule matched only the current executable")
+	}
+}
