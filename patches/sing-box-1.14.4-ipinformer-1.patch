new file mode 100644
index 0000000..35b4884
--- /dev/null
+++ b/route/ipinformer_live.go
@@ -0,0 +1,103 @@
+package route
+
+import (
+	"fmt"
+	"regexp"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/json"
+)
+
+type ipInformerLiveDocument struct {
+	Rules      []option.Rule              `json:"rules"`
+	Prompts    []ipInformerPromptDocument `json:"prompts,omitempty"`
+	SocketPath string                     `json:"socket_path,omitempty"`
+}
+
+type ipInformerPromptDocument struct {
+	ApplicationID       string   `json:"application_id"`
+	ApplicationName     string   `json:"application_name"`
+	ProcessPathRegex    []string `json:"process_path_regex"`
+	ExcludeProcessPaths []string `json:"exclude_process_paths,omitempty"`
+}
+
+type ipInformerLivePolicy struct {
+	rules      []adapter.Rule
+	prompts    []ipInformerPrompt
+	socketPath string
+}
+
+type ipInformerPrompt struct {
+	id, name string
+	patterns []*regexp.Regexp
+	excluded map[string]bool
+}
+
+// ApplyIPInformerRules atomically replaces only the routing decision table.
+// Existing TCP/UDP flows keep their selected outbound and the TUN stays up.
+func (r *Router) ApplyIPInformerRules(data []byte) error {
+	if len(data) > 2<<20 {
+		return fmt.Errorf("IP Informer rule document exceeds 2 MiB")
+	}
+	doc, err := json.UnmarshalExtendedContext[ipInformerLiveDocument](r.ctx, data)
+	if err != nil {
+		return err
+	}
+	if len(doc.Rules) > 4096 {
+		return fmt.Errorf("IP Informer rule document has too many rules")
+	}
+	compiled := make([]adapter.Rule, 0, len(doc.Rules)+len(r.rules))
+	for index, options := range doc.Rules {
+		if options.Type != "default" && options.Type != "logical" {
+			return fmt.Errorf("unsupported IP Informer rule %d type", index)
+		}
+		// The live document contains only self-contained rules. Rule-set
+		// subscriptions and lifecycle changes belong to the base config.
+		if options.Type == "default" && len(options.DefaultOptions.RuleSet) != 0 {
+			return fmt.Errorf("rule-set references require a full reload")
+		}
+		item, buildErr := R.NewRule(r.ctx, r.logger, options, false)
+		if buildErr != nil {
+			return fmt.Errorf("IP Informer rule %d: %w", index, buildErr)
+		}
+		if action, ok := item.Action().(*R.RuleActionRoute); ok {
+			if _, loaded := r.outbound.Outbound(action.Outbound); !loaded {
+				return fmt.Errorf("IP Informer rule %d references missing outbound %q", index, action.Outbound)
+			}
+		}
+		if startErr := item.Start(); startErr != nil {
+			return fmt.Errorf("IP Informer rule %d: %w", index, startErr)
+		}
+		compiled = append(compiled, item)
+	}
+	compiled = append(compiled, r.rules...)
+	prompts := make([]ipInformerPrompt, 0, len(doc.Prompts))
+	if len(doc.Prompts) > 256 {
+		return fmt.Errorf("too many IP Informer prompt rules")
+	}
+	for _, prompt := range doc.Prompts {
+		if prompt.ApplicationID == "" || prompt.ApplicationName == "" || len(prompt.ProcessPathRegex) == 0 {
+			return fmt.Errorf("invalid IP Informer prompt")
+		}
+		entry := ipInformerPrompt{id: prompt.ApplicationID, name: prompt.ApplicationName,
+			patterns: make([]*regexp.Regexp, 0, len(prompt.ProcessPathRegex)), excluded: make(map[string]bool)}
+		for _, pattern := range prompt.ProcessPathRegex {
+			matcher, parseErr := regexp.Compile(pattern)
+			if parseErr != nil {
+				return fmt.Errorf("invalid IP Informer prompt pattern: %w", parseErr)
+			}
+			entry.patterns = append(entry.patterns, matcher)
+		}
+		for _, path := range prompt.ExcludeProcessPaths {
+			entry.excluded[path] = true
+		}
+		prompts = append(prompts, entry)
+	}
+	r.livePolicy.Store(&ipInformerLivePolicy{rules: compiled, prompts: prompts, socketPath: doc.SocketPath})
+	r.promptAccess.Lock()
+	r.promptChoices = nil
+	r.promptAccess.Unlock()
+	return nil
+}
