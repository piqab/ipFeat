+}
+
+type ipFeatPromptDocument struct {
+	ApplicationID       string   `json:"application_id"`
+	ApplicationName     string   `json:"application_name"`
+	ProcessPathRegex    []string `json:"process_path_regex"`
+	ExcludeProcessPaths []string `json:"exclude_process_paths,omitempty"`
+}
+
+type ipFeatLivePolicy struct {
+	rules               []adapter.Rule
+	prompts             []ipFeatPrompt
+	socketPath          string
+	askUnknownProcesses bool
+	knownPaths          map[string]bool
+	knownPatterns       []*regexp.Regexp
+}
+
+type ipFeatPrompt struct {
+	id, name string
+	patterns []*regexp.Regexp
+	excluded map[string]bool
+	unknown  bool
+}
+
+// ApplyipFeatRules atomically replaces only the routing decision table.
+// Existing TCP/UDP flows keep their selected outbound and the TUN stays up.
+func (r *Router) ApplyipFeatRules(data []byte) error {
+	if len(data) > 2<<20 {
+		return fmt.Errorf("ipFeat rule document exceeds 2 MiB")
+	}
+	doc, err := json.UnmarshalExtendedContext[ipFeatLiveDocument](r.ctx, data)
+	if err != nil {
+		return err
+	}
+	if len(doc.Rules) > 4096 {
+		return fmt.Errorf("ipFeat rule document has too many rules")
+	}
+	compiled := make([]adapter.Rule, 0, len(doc.Rules)+len(r.rules))
+	for index, options := range doc.Rules {
+		if options.Type != "default" && options.Type != "logical" {
+			return fmt.Errorf("unsupported ipFeat rule %d type", index)
+		}
+		// The live document contains only self-contained rules. Rule-set
+		// subscriptions and lifecycle changes belong to the base config.
+		if options.Type == "default" && len(options.DefaultOptions.RuleSet) != 0 {
+			return fmt.Errorf("rule-set references require a full reload")
+		}
+		item, buildErr := R.NewRule(r.ctx, r.logger, options, false)
+		if buildErr != nil {
+			return fmt.Errorf("ipFeat rule %d: %w", index, buildErr)
+		}
+		if action, ok := item.Action().(*R.RuleActionRoute); ok {
+			if _, loaded := r.outbound.Outbound(action.Outbound); !loaded {
+				return fmt.Errorf("ipFeat rule %d references missing outbound %q", index, action.Outbound)
+			}
+		}
+		if startErr := item.Start(); startErr != nil {
+			return fmt.Errorf("ipFeat rule %d: %w", index, startErr)
+		}
+		compiled = append(compiled, item)
+	}
+	compiled = append(compiled, r.rules...)
+	prompts := make([]ipFeatPrompt, 0, len(doc.Prompts))
+	if len(doc.Prompts) > 256 {
+		return fmt.Errorf("too many ipFeat prompt rules")
+	}
+	for _, prompt := range doc.Prompts {
+		if prompt.ApplicationID == "" || prompt.ApplicationName == "" || len(prompt.ProcessPathRegex) == 0 {
+			return fmt.Errorf("invalid ipFeat prompt")
+		}
+		entry := ipFeatPrompt{id: prompt.ApplicationID, name: prompt.ApplicationName,
+			patterns: make([]*regexp.Regexp, 0, len(prompt.ProcessPathRegex)), excluded: make(map[string]bool)}
+		for _, pattern := range prompt.ProcessPathRegex {
+			matcher, parseErr := regexp.Compile(pattern)
+			if parseErr != nil {
+				return fmt.Errorf("invalid ipFeat prompt pattern: %w", parseErr)
+			}
+			entry.patterns = append(entry.patterns, matcher)
+		}
+		for _, path := range prompt.ExcludeProcessPaths {
+			entry.excluded[path] = true
+		}
+		prompts = append(prompts, entry)
+	}
+	if len(doc.KnownProcessPaths) > 4096 || len(doc.KnownProcessPathRegex) > 4096 {
+		return fmt.Errorf("too many known process paths")
+	}
+	knownPaths := make(map[string]bool, len(doc.KnownProcessPaths))
+	for _, path := range doc.KnownProcessPaths {
+		if path == "" {
+			return fmt.Errorf("empty known process path")
+		}
+		knownPaths[path] = true
+	}
+	knownPatterns := make([]*regexp.Regexp, 0, len(doc.KnownProcessPathRegex))
+	for _, pattern := range doc.KnownProcessPathRegex {
+		compiledPattern, err := regexp.Compile(pattern)
+		if err != nil {
+			return fmt.Errorf("invalid known process pattern: %w", err)
+		}
+		knownPatterns = append(knownPatterns, compiledPattern)
+	}
+	r.livePolicy.Store(&ipFeatLivePolicy{
+		rules: compiled, prompts: prompts, socketPath: doc.SocketPath,
+		askUnknownProcesses: doc.AskUnknownProcesses,
+		knownPaths:          knownPaths, knownPatterns: knownPatterns,
+	})
+	r.promptAccess.Lock()
+	for key := range r.promptChoices {
+		if !strings.HasPrefix(key, "unknown\x00") {
+			delete(r.promptChoices, key)
+		}
+	}
+	r.promptAccess.Unlock()
+	return nil
+}
