+func TestipFeatReplyCanArriveAfterInitialConnectionWait(t *testing.T) {
+	if os.Getuid() == 0 {
+		t.Skip("the prompt socket requires a non-root owner")
+	}
+	dir, err := os.MkdirTemp("/tmp", "ipi-prompt-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "prompt.sock")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	serverDone := make(chan error, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			serverDone <- err
+			return
+		}
+		defer conn.Close()
+		var request ipFeatPromptRequest
+		if err := json.NewDecoder(conn).Decode(&request); err != nil {
+			serverDone <- err
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+		serverDone <- json.NewEncoder(conn).Encode(ipFeatPromptReply{ID: request.ID, UseDefault: true})
+	}()
+	got := (&Router{}).askipFeat(path, ipFeatPromptRequest{ID: "late"})
+	if err := <-serverDone; err != nil {
+		t.Fatal(err)
+	}
+	if got != "\x00policy" {
+		t.Fatalf("late explicit policy reply = %q, want policy", got)
+	}
+}
+
+func TestipFeatPromptRecognizesItermChild(t *testing.T) {
+	router := &Router{}
+	router.livePolicy.Store(&ipFeatLivePolicy{
+		socketPath: "/tmp/ipfeat-test.sock",
+		prompts: []ipFeatPrompt{{
+			id: "iterm", name: "iTerm2",
+			patterns: []*regexp.Regexp{regexp.MustCompile(`^/Applications/iTerm\.app/.+$`)},
+			excluded: map[string]bool{},
+		}},
+	})
+	metadata := adapter.InboundContext{
+		IPVersion:   4,
+		Destination: M.Socksaddr{Addr: netip.MustParseAddr("8.8.8.8"), Port: 443},
+		ProcessInfo: &adapter.ConnectionOwner{
+			ProcessPath:          "/usr/bin/curl",
+			AncestorProcessPaths: []string{"/bin/zsh", "/Applications/iTerm.app/Contents/MacOS/iTerm2"},
+		},
+	}
+	if router.ipFeatPromptFor(&metadata) == nil {
+		t.Fatal("public IPv4 connection from iTerm child did not prompt")
+	}
+	metadata.Destination.Addr = netip.MustParseAddr("192.168.11.185")
+	if router.ipFeatPromptFor(&metadata) != nil {
+		t.Fatal("local IPv4 connection must not wait for a prompt")
+	}
+}
+
+func TestipFeatUnknownPromptUsesProcessLaunchIdentity(t *testing.T) {
+	router := &Router{}
+	router.livePolicy.Store(&ipFeatLivePolicy{
+		socketPath: "/tmp/ipfeat-test.sock", askUnknownProcesses: true,
+		knownPaths:    map[string]bool{"/usr/bin/ssh": true},
+		knownPatterns: []*regexp.Regexp{regexp.MustCompile(`^/Applications/iTerm\.app/.+$`)},
+	})
+	owner := &adapter.ConnectionOwner{
+		ProcessID: 42, ProcessStartUnixNano: 100, UserId: 501,
+		ProcessPath: "/opt/homebrew/bin/brew",
+	}
+	metadata := adapter.InboundContext{
+		IPVersion: 4, Destination: M.Socksaddr{Addr: netip.MustParseAddr("8.8.8.8"), Port: 443},
+		ProcessInfo: owner,
+	}
+	prompt := router.ipFeatPromptFor(&metadata)
+	if prompt == nil || !prompt.unknown {
+		t.Fatal("unlisted user process must prompt")
+	}
+	key := ipFeatPromptKey(prompt, owner)
+	owner.ProcessStartUnixNano = 101
+	if key == ipFeatPromptKey(prompt, owner) {
+		t.Fatal("new process launch must get a new choice")
+	}
+	owner.ProcessPath = "/usr/bin/ssh"
+	if router.ipFeatPromptFor(&metadata) != nil {
+		t.Fatal("listed command must not prompt")
+	}
+	owner.ProcessPath = "/opt/homebrew/bin/brew"
+	owner.AncestorProcessPaths = []string{"/Applications/iTerm.app/Contents/MacOS/iTerm2"}
+	if router.ipFeatPromptFor(&metadata) != nil {
+		t.Fatal("child of listed application is not unlisted")
+	}
+	owner.AncestorProcessPaths = nil
+	metadata.Destination.Addr = netip.MustParseAddr("192.168.11.130")
+	if router.ipFeatPromptFor(&metadata) != nil {
+		t.Fatal("local IPv4 must not prompt")
+	}
+	metadata.Destination.Addr = netip.MustParseAddr("8.8.8.8")
+	owner.ProcessStartUnixNano = 0
+	if router.ipFeatPromptFor(&metadata) != nil {
+		t.Fatal("unverified process start must not prompt")
+	}
+}
