diff --git a/common/process/ancestor_darwin.go b/common/process/ancestor_darwin.go
new file mode 100644
index 0000000..2094b81
--- /dev/null
+++ b/common/process/ancestor_darwin.go
@@ -0,0 +1,102 @@
+//go:build darwin
+
+package process
+
+import (
+	"encoding/binary"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// proc_bsdinfo is 136 bytes on Darwin. These offsets are defined in
+// <sys/proc_info.h>; reject a short result rather than using incomplete data.
+const darwinBSDInfoSize = 136
+
+type darwinBSDInfo struct {
+	pid, ppid uint32
+	uid       int32
+	startSec  uint64
+	startUSec uint64
+}
+
+func readDarwinBSDInfo(pid uint32) (darwinBSDInfo, bool) {
+	var buf [darwinBSDInfoSize]byte
+	n, _, errno := syscall.Syscall6(syscall.SYS_PROC_INFO, 2, uintptr(pid), 3, 0,
+		uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)))
+	if errno != 0 || n != uintptr(len(buf)) {
+		// macOS can hide PROC_PIDTBSDINFO for the setuid login process even
+		// though kern.proc.pid still exposes its stable PID, parent and start time.
+		info, err := unix.SysctlKinfoProc("kern.proc.pid", int(pid))
+		if err != nil || info.Proc.P_pid != int32(pid) || info.Proc.P_starttime.Sec <= 0 {
+			return darwinBSDInfo{}, false
+		}
+		return darwinBSDInfo{
+			pid: uint32(info.Proc.P_pid), ppid: uint32(info.Eproc.Ppid),
+			uid:       int32(info.Eproc.Ucred.Uid),
+			startSec:  uint64(info.Proc.P_starttime.Sec),
+			startUSec: uint64(info.Proc.P_starttime.Usec),
+		}, true
+	}
+	return darwinBSDInfo{
+		pid:       binary.NativeEndian.Uint32(buf[12:16]),
+		ppid:      binary.NativeEndian.Uint32(buf[16:20]),
+		uid:       int32(binary.NativeEndian.Uint32(buf[20:24])),
+		startSec:  binary.NativeEndian.Uint64(buf[120:128]),
+		startUSec: binary.NativeEndian.Uint64(buf[128:136]),
+	}, true
+}
+
+func sameDarwinProcess(a, b darwinBSDInfo) bool {
+	return a.pid == b.pid && a.ppid == b.ppid && a.uid == b.uid &&
+		a.startSec == b.startSec && a.startUSec == b.startUSec
+}
+
+// darwinAncestorPaths returns verified same-user ancestors. macOS terminals
+// commonly place the root-owned /usr/bin/login between the terminal and shell;
+// only that exact system binary may bridge the UID boundary.
+func darwinAncestorPaths(pid uint32, socketUID int32) []string {
+	return darwinAncestorPathsWith(pid, socketUID, readDarwinBSDInfo, getExecPathFromPID)
+}
+
+func darwinAncestorPathsWith(
+	pid uint32, socketUID int32,
+	read func(uint32) (darwinBSDInfo, bool),
+	executable func(uint32) (string, error),
+) []string {
+	child, ok := read(pid)
+	if !ok || child.pid != pid || child.uid != socketUID {
+		return nil
+	}
+	paths := make([]string, 0, 4)
+	seen := map[uint32]bool{pid: true}
+	crossedLogin := false
+	for depth := 0; depth < 16 && child.ppid > 1 && !seen[child.ppid]; depth++ {
+		parentPID := child.ppid
+		seen[parentPID] = true
+		parent, ok := read(parentPID)
+		loginBridge := parent.uid == 0 && !crossedLogin
+		if !ok || parent.pid != parentPID || (parent.uid != socketUID && !loginBridge) ||
+			parent.startSec > child.startSec ||
+			(parent.startSec == child.startSec && parent.startUSec > child.startUSec) {
+			break
+		}
+		path, err := executable(parentPID)
+		verified, stillRunning := read(parentPID)
+		if err != nil || !stillRunning || !sameDarwinProcess(parent, verified) || path == "" {
+			break
+		}
+		if loginBridge {
+			if path != "/usr/bin/login" {
+				break
+			}
+			crossedLogin = true
+			child = parent
+			continue
+		}
+		paths = append(paths, path)
+		child = parent
+	}
+	return paths
+}
diff --git a/common/process/ancestor_darwin_test.go b/common/process/ancestor_darwin_test.go
new file mode 100644
index 0000000..bc48849
--- /dev/null
+++ b/common/process/ancestor_darwin_test.go
@@ -0,0 +1,81 @@
+//go:build darwin
+
+package process
+
+import (
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestReadDarwinBSDInfoForCurrentProcess(t *testing.T) {
+	info, ok := readDarwinBSDInfo(uint32(os.Getpid()))
+	if !ok {
+		t.Fatal("could not read proc_bsdinfo")
+	}
+	if info.pid != uint32(os.Getpid()) || info.ppid != uint32(os.Getppid()) || info.uid != int32(os.Getuid()) {
+		t.Fatalf("wrong identity: %+v", info)
+	}
+	if info.startSec == 0 {
+		t.Fatal("missing process start time")
+	}
+}
+
+func TestAncestorsRejectWrongUID(t *testing.T) {
+	paths := darwinAncestorPaths(uint32(os.Getpid()), int32(os.Getuid()+1))
+	if len(paths) != 0 {
+		t.Fatalf("wrong UID inherited paths: %v", paths)
+	}
+}
+
+func TestAncestorOfSpawnedCommandIncludesCurrentProcess(t *testing.T) {
+	command := exec.Command("/bin/sleep", "2")
+	if err := command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = command.Process.Kill(); _ = command.Wait() }()
+	paths := darwinAncestorPaths(uint32(command.Process.Pid), int32(os.Getuid()))
+	current, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range paths {
+		if filepath.Base(path) == filepath.Base(current) {
+			return
+		}
+	}
+	t.Fatalf("spawned command did not inherit current process: %v", paths)
+}
+
+func TestAncestorCrossesVerifiedSystemLogin(t *testing.T) {
+	processes := map[uint32]darwinBSDInfo{
+		10: {pid: 10, ppid: 20, uid: 501, startSec: 100},
+		20: {pid: 20, ppid: 30, uid: 501, startSec: 90},
+		30: {pid: 30, ppid: 40, uid: 0, startSec: 80},
+		40: {pid: 40, ppid: 50, uid: 501, startSec: 70},
+		50: {pid: 50, ppid: 1, uid: 501, startSec: 60},
+	}
+	paths := map[uint32]string{
+		20: "/bin/zsh", 30: "/usr/bin/login",
+		40: "/Users/test/Library/Application Support/iTerm2/iTermServer",
+		50: "/Applications/iTerm.app/Contents/MacOS/iTerm2",
+	}
+	read := func(pid uint32) (darwinBSDInfo, bool) { item, ok := processes[pid]; return item, ok }
+	executable := func(pid uint32) (string, error) {
+		if path, ok := paths[pid]; ok {
+			return path, nil
+		}
+		return "", errors.New("missing executable")
+	}
+	got := darwinAncestorPathsWith(10, 501, read, executable)
+	if len(got) != 3 || got[0] != paths[20] || got[1] != paths[40] || got[2] != paths[50] {
+		t.Fatalf("iTerm ancestry was lost across login: %v", got)
+	}
+	paths[30] = "/usr/bin/sudo"
+	got = darwinAncestorPathsWith(10, 501, read, executable)
+	if len(got) != 1 || got[0] != paths[20] {
+		t.Fatalf("untrusted root process crossed UID boundary: %v", got)
+	}
+}
