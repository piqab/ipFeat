index 0000000..fd547bb
--- /dev/null
+++ b/route/ipfeat_prompt.go
@@ -0,0 +1,255 @@
+package route
+
+import (
+	"context"
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	R "github.com/sagernet/sing-box/route/rule"
+	"golang.org/x/sys/unix"
+)
+
+type ipFeatPromptChoice struct {
+	ready     chan struct{}
+	route     string
+	createdAt time.Time
+}
+
+func ipFeatBlockedRule() adapter.Rule {
+	return ipFeatDecisionRule{action: &R.RuleActionReject{Method: C.RuleActionRejectMethodDefault, NoDrop: true}}
+}
+
+type ipFeatPromptRequest struct {
+	ID              string `json:"id"`
+	Kind            string `json:"kind,omitempty"`
+	ApplicationID   string `json:"application_id"`
+	ApplicationName string `json:"application_name"`
+	CommandPath     string `json:"command_path"`
+	ParentPath      string `json:"parent_path,omitempty"`
+}
+
+type ipFeatPromptReply struct {
+	ID         string `json:"id"`
+	Route      string `json:"route"`
+	UseDefault bool   `json:"use_default,omitempty"`
+}
+
+// A prompt is only eligible for a positively identified descendant's public
+// IPv4 connection. Private traffic, DNS, and ambiguous ownership use the
+// ordinary policy without pausing the flow.
+func (r *Router) ipFeatPromptFor(metadata *adapter.InboundContext) *ipFeatPrompt {
+	policy := r.livePolicy.Load()
+	if policy == nil || policy.socketPath == "" || metadata.ProcessInfo == nil ||
+		metadata.ProcessInfo.ProcessPath == "" ||
+		metadata.IPVersion != 4 || metadata.Destination.Port == 53 {
+		return nil
+	}
+	addr := metadata.Destination.Addr
+	if !addr.IsValid() || !addr.IsGlobalUnicast() || addr.IsPrivate() ||
+		addr.IsLoopback() || addr.IsLinkLocalUnicast() {
+		return nil
+	}
+	for i := range policy.prompts {
+		prompt := &policy.prompts[i]
+		if prompt.excluded[metadata.ProcessInfo.ProcessPath] {
+			continue
+		}
+		self := false
+		ancestor := false
+		for _, pattern := range prompt.patterns {
+			self = self || pattern.MatchString(metadata.ProcessInfo.ProcessPath)
+			for _, path := range metadata.ProcessInfo.AncestorProcessPaths {
+				ancestor = ancestor || pattern.MatchString(path)
+			}
+		}
+		if ancestor && !self {
+			return prompt
+		}
+	}
+	owner := metadata.ProcessInfo
+	if !policy.askUnknownProcesses || owner.UserId < 500 ||
+		owner.ProcessID == 0 || owner.ProcessStartUnixNano == 0 ||
+		policy.knownPaths[owner.ProcessPath] {
+		return nil
+	}
+	for _, pattern := range policy.knownPatterns {
+		if pattern.MatchString(owner.ProcessPath) {
+			return nil
+		}
+		for _, ancestor := range owner.AncestorProcessPaths {
+			if pattern.MatchString(ancestor) {
+				return nil
+			}
+		}
+	}
+	return &ipFeatPrompt{name: filepath.Base(owner.ProcessPath), unknown: true}
+}
+
+func (r *Router) ipFeatPromptRule(ctx context.Context, metadata *adapter.InboundContext) adapter.Rule {
+	prompt := r.ipFeatPromptFor(metadata)
+	if prompt == nil {
+		return nil
+	}
+	policy := r.livePolicy.Load()
+	if policy == nil {
+		return nil
+	}
+	key := ipFeatPromptKey(prompt, metadata.ProcessInfo)
+	kind := "child"
+	if prompt.unknown {
+		kind = "unknown"
+	}
+	r.promptAccess.Lock()
+	if r.promptChoices == nil {
+		r.promptChoices = make(map[string]*ipFeatPromptChoice)
+	}
+	choice := r.promptChoices[key]
+	first := choice == nil
+	if first {
+		if len(r.promptChoices) >= 1024 {
+			var oldestKey string
+			var oldestTime time.Time
+			for candidateKey, candidate := range r.promptChoices {
+				if !strings.HasPrefix(candidateKey, "unknown\x00") {
+					continue
+				}
+				select {
+				case <-candidate.ready:
+					if oldestKey == "" || candidate.createdAt.Before(oldestTime) {
+						oldestKey, oldestTime = candidateKey, candidate.createdAt
+					}
+				default:
+				}
+			}
+			if oldestKey != "" {
+				delete(r.promptChoices, oldestKey)
+			}
+		}
+		if r.promptPending >= 16 || len(r.promptChoices) >= 1024 {
+			r.promptAccess.Unlock()
+			return ipFeatBlockedRule()
+		}
+		choice = &ipFeatPromptChoice{ready: make(chan struct{}), createdAt: time.Now()}
+		r.promptChoices[key] = choice
+		r.promptPending++
+	}
+	r.promptAccess.Unlock()
+	if first {
+		parentPath := ""
+		if len(metadata.ProcessInfo.AncestorProcessPaths) != 0 {
+			parentPath = metadata.ProcessInfo.AncestorProcessPaths[0]
+		}
+		request := ipFeatPromptRequest{
+			ID: key, Kind: kind,
+			ApplicationID: prompt.id, ApplicationName: prompt.name,
+			CommandPath: metadata.ProcessInfo.ProcessPath, ParentPath: parentPath,
+		}
+		// Keep the request alive after this connection times out. A late
+		// selection applies to subsequent flows from the same process.
+		go func() {
+			route := r.askipFeat(policy.socketPath, request)
+			r.promptAccess.Lock()
+			choice.route = route
+			close(choice.ready)
+			r.promptPending--
+			r.promptAccess.Unlock()
+		}()
+	}
+	select {
+	case <-choice.ready:
+	case <-time.After(20 * time.Second):
+		return ipFeatBlockedRule()
+	case <-ctx.Done():
+		return ipFeatBlockedRule()
+	}
+	r.promptAccess.Lock()
+	route := choice.route
+	r.promptAccess.Unlock()
+	if route == "" || route == "reject" {
+		return ipFeatBlockedRule()
+	}
+	if route == "\x00policy" {
+		return nil
+	}
+	if _, exists := r.outbound.Outbound(route); !exists {
+		return ipFeatBlockedRule()
+	}
+	return ipFeatDecisionRule{action: &R.RuleActionRoute{Outbound: route}}
+}
+
+func ipFeatPromptKey(prompt *ipFeatPrompt, owner *adapter.ConnectionOwner) string {
+	if !prompt.unknown {
+		return prompt.id + "\x00" + owner.ProcessPath
+	}
+	return "unknown\x00" + strconv.FormatInt(int64(owner.UserId), 10) + "\x00" +
+		strconv.FormatUint(uint64(owner.ProcessID), 10) + "\x00" +
+		strconv.FormatUint(owner.ProcessStartUnixNano, 10) + "\x00" + owner.ProcessPath
+}
+
+func (r *Router) askipFeat(socketPath string, request ipFeatPromptRequest) string {
+	info, err := os.Stat(socketPath)
+	if err != nil || info.Mode()&os.ModeSocket == 0 {
+		return ""
+	}
+	owner, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || owner.Uid == 0 {
+		return ""
+	}
+	conn, err := (&net.Dialer{Timeout: 500 * time.Millisecond}).DialContext(context.Background(), "unix", socketPath)
+	if err != nil {
+		return ""
+	}
+	defer conn.Close()
+	raw, err := conn.(*net.UnixConn).SyscallConn()
+	if err != nil {
+		return ""
+	}
+	var peerUID uint32
+	var credentialErr error
+	if err = raw.Control(func(fd uintptr) {
+		var credential *unix.Xucred
+		credential, credentialErr = unix.GetsockoptXucred(int(fd), unix.SOL_LOCAL, unix.LOCAL_PEERCRED)
+		if credentialErr == nil {
+			peerUID = credential.Uid
+		}
+	}); err != nil || credentialErr != nil || peerUID != owner.Uid {
+		return ""
+	}
+	if err = json.NewEncoder(conn).Encode(request); err != nil {
+		return ""
+	}
+	var reply ipFeatPromptReply
+	if err = json.NewDecoder(conn).Decode(&reply); err != nil || reply.ID != request.ID {
+		return ""
+	}
+	if reply.Route == "reject" {
+		return "reject"
+	}
+	if reply.UseDefault {
+		return "\x00policy"
+	}
+	if strings.ContainsAny(reply.Route, "\x00\r\n") {
+		return ""
+	}
+	if _, exists := r.outbound.Outbound(reply.Route); !exists {
+		return ""
+	}
+	return reply.Route
+}
+
+type ipFeatDecisionRule struct{ action adapter.RuleAction }
+
+func (ipFeatDecisionRule) Match(*adapter.InboundContext) bool { return true }
+func (ipFeatDecisionRule) String() string                     { return "ipFeat child command choice" }
+func (ipFeatDecisionRule) Type() string                       { return C.RuleTypeDefault }
+func (r ipFeatDecisionRule) Action() adapter.RuleAction       { return r.action }
+func (ipFeatDecisionRule) Start() error                       { return nil }
+func (ipFeatDecisionRule) Close() error                       { return nil }
